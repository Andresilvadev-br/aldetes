# Exemplo SEM segredos. Gere o seu .env real com: pnpm setup
# (cria senhas/chaves aleatórias e infra/livekit/livekit.dev.yaml)
NODE_ENV=development
API_PORT=3001
API_PUBLIC_URL=http://localhost:3001
WEB_ORIGINS=http://localhost:5173,app://aldetes
DATABASE_URL=postgresql://aldetes:<senha>@127.0.0.1:5433/aldetes
REDIS_URL=redis://127.0.0.1:6380
STORAGE_DRIVER=local
LIVEKIT_API_KEY=<gerado>
LIVEKIT_API_SECRET=<gerado>
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_HTTP_URL=http://127.0.0.1:7880
SMTP_HOST=
