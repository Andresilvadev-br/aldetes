{
  "name": "aldetes",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "infra:up": "docker compose -f infra/docker-compose.dev.yml --env-file .env up -d",
    "infra:down": "docker compose -f infra/docker-compose.dev.yml --env-file .env down",
    "setup": "node scripts/setup-env.mjs",
    "dev:server": "pnpm --filter @aldetes/server dev",
    "dev:web": "pnpm --filter @aldetes/web dev",
    "dev:desktop": "pnpm --filter @aldetes/desktop dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r --filter=!@aldetes/desktop test",
    "setup:prod": "node scripts/setup-prod.mjs",
    "livekit:dev": "bash scripts/livekit-dev.sh",
    "test:e2e": "node e2e/two-clients.mjs",
    "test:desktop": "node e2e/desktop-smoke.mjs",
    "perf": "node e2e/perf.mjs",
    "dist:desktop": "pnpm --filter @aldetes/desktop dist"
  }
}
