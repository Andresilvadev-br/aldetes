# Builds the web client and serves it (plus reverse-proxies the API) with Caddy (automatic HTTPS).
FROM node:22-bookworm-slim AS build
RUN corepack enable
WORKDIR /src
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml tsconfig.base.json ./
COPY packages/shared/package.json packages/shared/
COPY apps/web/package.json apps/web/
RUN pnpm install --frozen-lockfile --filter @aldetes/web...
COPY packages/shared packages/shared
COPY apps/web apps/web
RUN cd apps/web && pnpm build

FROM caddy:2.10-alpine
COPY --from=build /src/apps/web/dist /srv/web
COPY infra/prod/Caddyfile /etc/caddy/Caddyfile
