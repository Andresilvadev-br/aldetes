# --- build ---
FROM node:22-bookworm-slim AS build
RUN corepack enable && apt-get update && apt-get install -y --no-install-recommends openssl python3 make g++ && rm -rf /var/lib/apt/lists/*
WORKDIR /src
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml tsconfig.base.json ./
COPY packages/shared/package.json packages/shared/
COPY apps/server/package.json apps/server/
RUN pnpm install --frozen-lockfile --filter @aldetes/server...
COPY packages/shared packages/shared
COPY apps/server apps/server
RUN cd apps/server && pnpm exec prisma generate && pnpm build \
 && pnpm deploy --filter @aldetes/server --prod --legacy /out \
 && cp -r dist prisma /out/ \
 && cd /out && node node_modules/prisma/build/index.js generate --schema prisma/schema.prisma

# --- runtime ---
FROM node:22-bookworm-slim
# ffmpeg: short video banners are always re-encoded server-side (lib/transcode.ts)
RUN apt-get update && apt-get install -y --no-install-recommends openssl ca-certificates tini ffmpeg && rm -rf /var/lib/apt/lists/* \
 && useradd -r -u 10001 aldetes && mkdir -p /data/uploads && chown aldetes /data/uploads
WORKDIR /app
COPY --from=build /out /app
USER aldetes
ENV NODE_ENV=production STORAGE_LOCAL_DIR=/data/uploads
EXPOSE 3001
ENTRYPOINT ["/usr/bin/tini", "--"]
# Apply pending migrations (non-destructive `migrate deploy`) then start.
CMD ["sh", "-c", "node node_modules/prisma/build/index.js migrate deploy --schema prisma/schema.prisma && node dist/index.js"]
