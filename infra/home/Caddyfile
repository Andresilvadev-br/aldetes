# Modo "PC de casa": HTTP local; o HTTPS é feito pelo `tailscale serve` (certificado *.ts.net).
{
	auto_https off
}

:8080 {
	encode zstd gzip
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
	@backend path /api/* /socket.io/* /cdn/*
	handle @backend {
		reverse_proxy api:3001
	}
	handle {
		root * /srv/web
		try_files {path} /index.html
		file_server
	}
}
